# Copy this file to server/.env for local REST server credentials.
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333

OPENAI_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

EMBEDDER_PROVIDER=gemini
EMBEDDER_MODEL=models/gemini-embedding-001

# Optional: JSON config file loaded at startup. Defaults to server/configs/config.json.
CONFIG_PATH=

# Optional: set to enable API key authentication on all endpoints
ADMIN_API_KEY=
